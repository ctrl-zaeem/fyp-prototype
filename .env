OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

OLLAMA_TIMEOUT_SEC=60
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=350

OLLAMA_EMBEDDING_MODEL=nomic-embed-text

CHROMA_COLLECTION=agri_multilingual_docs
CHROMA_DIR=/home/ubuntu/project/vectorstore/chroma_db

EMBEDDING_CACHE_PATH=/home/ubuntu/project/vectorstore/embedding_cache.json

DATASET_DIR=/home/ubuntu/project/datasets

RETRIEVAL_TOP_K=4
CHUNK_SIZE=900
CHUNK_OVERLAP=180

WHISPER_MODEL_NAME=medium
AUDIO_DIR=/home/ubuntu/project/audio
